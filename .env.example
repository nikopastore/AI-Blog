# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ai_blog"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-generate-with-openssl-rand-base64-32"

# Google OAuth (Get from https://console.cloud.google.com)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Email Provider (Optional - for magic link authentication)
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="AI Business Insights <noreply@yourdomain.com>"

# Resend (Email delivery service - Get API key from https://resend.com)
RESEND_API_KEY="re_your_resend_api_key"

# OpenAI API (Get from https://platform.openai.com)
OPENAI_API_KEY="sk-your-openai-api-key"

# Cron Secret (Generate a random secret for scheduled tasks)
CRON_SECRET="your-random-secret-for-cron-jobs"

# App URL (Production URL)
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
